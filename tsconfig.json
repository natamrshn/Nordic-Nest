{
	"compilerOptions": {
		"esModuleInterop": true,
		"baseUrl": ".",
		"jsx": "react-jsx",
		"lib": [
			"dom",
			"es2015"
		],
		"paths": {
			"~assets/*": [
				"src/assets/*"
			],
			"~modules/*": [
				"src/modules/*"
			],
			"~router/*": [
				"src/router/*"
			],
			"~shared/*": [
				"src/shared/*"
			],
			"~/*": [
				"src/*"
			],
			"~types/*": [
				"src/types/*"
			],
			"~card/*": [
				"src/modules/card/*"
			],
			"~favourites/*": [
				"src/modules/favourites/*"
			],
			"~search/*": [
				"src/modules/search/*"
			]
		}
	}
}